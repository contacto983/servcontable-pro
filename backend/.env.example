NODE_ENV=production
PORT=4000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/servcontable_pro
DATABASE_SSL=false

# Seguridad: usar una clave larga, privada y distinta por instalacion.
JWT_SECRET=cambiar_por_una_clave_segura_de_minimo_32_caracteres

# Administrador general de ServContable.
# Al iniciar el backend, si estos datos existen, se crea o actualiza este usuario como superadmin.
ADMIN_NOMBRE=Administrador ServContable
ADMIN_EMAIL=admin@tu-dominio.cl
ADMIN_PASSWORD=cambiar_esta_clave_inicial

# Mantener false para venta. Los clientes deben ser creados desde Usuarios y accesos.
ALLOW_PUBLIC_REGISTRATION=false

# Demo: mantener false en operacion real.
DEMO_MODE=false
DEMO_EMAIL=demo@servcontable.cl
DEMO_NOMBRE=Usuario Demo ServContable
DEMO_EMPRESA_RUT=76.543.210-9
DEMO_EMPRESA_RAZON_SOCIAL=EMPRESA DEMO SERVCONTABLE SpA

# Dominio del frontend publicado. Para mas de uno, separar por coma.
CORS_ORIGIN=https://www.servcontablepro.cl,https://servcontablepro.cl,https://app.servcontablepro.cl,https://demo.servcontablepro.cl

# Mercado Pago: usar siempre credenciales privadas de produccion en el backend.
# No pegar este token en la web publica ni en el frontend.
MP_ACCESS_TOKEN=APP_USR_token_privado_de_la_nueva_cuenta
PUBLIC_BASE_URL=https://www.servcontablepro.cl
BACKEND_PUBLIC_URL=https://api.servcontablepro.cl
MP_WEBHOOK_URL=https://api.servcontablepro.cl/api/pagos-mercadopago/webhook
